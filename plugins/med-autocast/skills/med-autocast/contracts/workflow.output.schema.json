{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "artifact_refs",
    "quality_debt"
  ],
  "properties": {
    "status": {
      "enum": [
        "completed",
        "completed_with_quality_debt",
        "blocked"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_debt": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
