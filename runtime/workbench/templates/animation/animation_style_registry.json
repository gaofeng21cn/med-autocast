{
  "surface_kind": "medical_video_animation_style_registry",
  "version": "medical-video-animation-style-registry.v1",
  "owner": "med-autocast",
  "default_style_id": "paper_collage",
  "selection_policy": {
    "user_may_choose_style_id": true,
    "style_selection_is_advisory": true,
    "unknown_style_policy": "preserve_request_and_route_to_story_directing",
    "renderer_selection_is_advisory": true,
    "unavailable_renderer_policy": "preserve_requested_style_and_renderer; continue preproduction or use a compatible active renderer with explicit quality debt",
    "backend_is_separate_from_style": true,
    "video_model_is_explicit_backend_only": true
  },
  "shared_render_contract": {
    "version": "time-addressable-html-renderer.v1",
    "required_for_frame_capture": ["window.__seek(t_seconds)"],
    "recommended_for_review": ["window.__ready", "window.__total", "window.__cuts", "window.__layout", "window.__score", "window.__rendererId", "window.__requestedStyleId", "window.__styleId"],
    "runtime_identity_semantics": {
      "renderer_id": "actual renderer implementation that executed",
      "requested_style_id": "requested or planned style; does not prove visual realization",
      "style_id": "implementation-declared realized style; absence is a review debt, not a render blocker",
      "visual_style_quality": "requires semantic visual review and cannot be approved by runtime metadata"
    },
    "seek_must_be_deterministic_and_random_access": true,
    "frame_capture_owner": "render_javascript_animation.py + Chrome + FFmpeg",
    "unreported_or_mismatched_selection_policy": "render_review_candidate_when_seekable; record_quality_debt; never_claim_requested_renderer_or_style_was_used"
  },
  "maturity_legend": {"default": "当前主线已有端到端工作区与渲染支持", "supported_next": "可在导演阶段选择和规划；若目标 renderer 尚未激活，保留风格意图并用兼容实现继续或记录质量债务", "experimental": "概念可试作，不承诺通用模板已提供完整实现", "auxiliary": "作为其他主风格的局部手段，不单独替代视觉叙事", "specialized": "需要作者/系列基线或特殊医学审查范围"},
  "renderers": [
    {
      "renderer_id": "canvas2d",
      "status": "active",
      "adapter_status": "implemented",
      "native_seek_api": "seconds",
      "shared_seek_bridge": "direct",
      "purpose": "透明 PNG、纸材、遮挡、阴影、局部变换和确定性逐帧输出",
      "entry_refs": ["runtime/workbench/templates/animation/paper_theatre/", "runtime/workbench/scripts/render_local_animation.mjs"]
    },
    {
      "renderer_id": "svg",
      "status": "planned",
      "adapter_status": "planned",
      "native_seek_api": "seconds",
      "shared_seek_bridge": "window.__seek(t_seconds)",
      "purpose": "线条动画、科学图示、路径绘制和高质量文字",
      "entry_refs": ["runtime/workbench/docs/19_纸剧场模块架构与镜头打磨.md"]
    },
    {
      "renderer_id": "remotion_dom",
      "status": "planned",
      "adapter_status": "planned",
      "native_seek_api": "frames",
      "shared_seek_bridge": "window.__seek(t_seconds)-to-frame adapter required",
      "purpose": "React/DOM 排版、复杂字幕和可复用 composition",
      "entry_refs": ["https://www.remotion.dev/docs/"]
    },
    {
      "renderer_id": "webgl_three",
      "status": "experimental",
      "adapter_status": "experimental",
      "native_seek_api": "seconds",
      "shared_seek_bridge": "window.__seek(t_seconds)",
      "purpose": "2.5D 多层视差和医学三维结构",
      "entry_refs": ["https://threejs.org/docs/"]
    }
  ],
